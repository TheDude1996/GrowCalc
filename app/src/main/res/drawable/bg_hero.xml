<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/hero_end"
                android:startColor="@color/hero_start"
                android:type="linear" />
        </shape>
    </item>
    <!-- Soft light blobs for depth -->
    <item android:gravity="top|end" android:width="180dp" android:height="180dp" android:top="-60dp" android:right="-50dp">
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:width="110dp" android:height="110dp" android:bottom="-40dp" android:right="70dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
