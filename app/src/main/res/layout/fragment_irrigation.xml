<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                style="@style/Grow.IconBadge"
                android:backgroundTint="@color/accent_water_bg"
                android:src="@drawable/ic_tool_water"
                app:tint="@color/accent_water" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/tool_irrigation_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_irrigation_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dripper -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Grow.Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_flow_per_dripper"
                        android:textAppearance="@style/TextAppearance.Grow.Overline" />

                    <ImageButton
                        android:id="@+id/btnFlowInfo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="-12dp"
                        android:layout_marginEnd="-12dp"
                        android:layout_marginBottom="-12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/btn_flow_info"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPurple"
                        style="@style/Widget.Grow.Chip.Dripper"
                        android:contentDescription="@string/dripper_purple_desc"
                        android:text="@string/dripper_purple"
                        app:chipIconTint="@color/dripper_purple" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlue"
                        style="@style/Widget.Grow.Chip.Dripper"
                        android:contentDescription="@string/dripper_blue_desc"
                        android:text="@string/dripper_blue"
                        app:chipIconTint="@color/dripper_blue" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBrown"
                        style="@style/Widget.Grow.Chip.Dripper"
                        android:contentDescription="@string/dripper_brown_desc"
                        android:text="@string/dripper_brown"
                        app:chipIconTint="@color/dripper_brown" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGreen"
                        style="@style/Widget.Grow.Chip.Dripper"
                        android:contentDescription="@string/dripper_green_desc"
                        android:text="@string/dripper_green"
                        app:chipIconTint="@color/dripper_green" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRed"
                        style="@style/Widget.Grow.Chip.Dripper"
                        android:contentDescription="@string/dripper_red_desc"
                        android:text="@string/dripper_red"
                        app:chipIconTint="@color/dripper_red" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCustom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dripper_custom" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCustomFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_custom_flow"
                    android:visibility="gone"
                    app:suffixText="@string/unit_lph">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCustomFlow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789.,"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrateFlow"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:text="@string/btn_calibrate_flow"
                    app:icon="@drawable/ic_measure_cup" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_drippers_per_pot"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDrippersMinus"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/btn_drippers_minus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="12dp"
                        app:icon="@drawable/ic_remove"
                        app:iconPadding="0dp" />

                    <TextView
                        android:id="@+id/textDrippers"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceTitleLarge" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDrippersPlus"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/btn_drippers_plus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="12dp"
                        app:icon="@drawable/ic_add"
                        app:iconPadding="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Waterings -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Grow.Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/label_waterings_section"
                    android:textAppearance="@style/TextAppearance.Grow.Overline" />

                <LinearLayout
                    android:id="@+id/wateringsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddWatering"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:text="@string/btn_add_watering"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pots & tank -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Grow.Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/label_pots_tank_section"
                    android:textAppearance="@style/TextAppearance.Grow.Overline" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_pots">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_tank">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789.,"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Result -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            style="@style/Widget.Grow.Card.Result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="@string/label_per_pot_day"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/textPerPotDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Grow.BigNumber" />

                <TextView
                    android:id="@+id/textResultDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Grow.StatTile"
                        android:layout_marginEnd="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_total_day" />

                        <TextView
                            android:id="@+id/textTotalDay"
                            style="@style/Grow.StatValue" />

                        <TextView
                            android:id="@+id/textPots"
                            style="@style/Grow.StatLabel" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileTank"
                        style="@style/Grow.StatTile"
                        android:layout_marginStart="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_tank_lasts" />

                        <TextView
                            android:id="@+id/textTankDays"
                            style="@style/Grow.StatValue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reverse mode -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Grow.Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/label_reverse_section"
                    android:textAppearance="@style/TextAppearance.Grow.Overline" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_target_amount">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789.,"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/textReverseResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUseAsWatering"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:text="@string/btn_use_as_watering"
                    android:visibility="gone"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Presets -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Grow.Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_presets_section"
                    android:textAppearance="@style/TextAppearance.Grow.Overline" />

                <TextView
                    android:id="@+id/textPresetsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/presets_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPresets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.Grow.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/btn_zuruecksetzen"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:icon="@drawable/ic_refresh"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePreset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/btn_save_preset"
                app:icon="@drawable/ic_save" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
