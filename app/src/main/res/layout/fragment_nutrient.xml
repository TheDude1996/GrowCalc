<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                style="@style/Grow.IconBadge"
                android:backgroundTint="@color/accent_nutrient_bg"
                android:src="@drawable/ic_tool_nutrient"
                app:tint="@color/accent_nutrient" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/tool_nutrient_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_nutrient_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Schema selection -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Grow.Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/label_schema_section"
                    android:textAppearance="@style/TextAppearance.Grow.Overline" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Grow.TextInputLayout.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_manufacturer">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropdownManufacturer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutLine"
                    style="@style/Widget.Grow.TextInputLayout.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_line"
                    android:visibility="gone">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropdownLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutProgram"
                    style="@style/Widget.Grow.TextInputLayout.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_program"
                    android:visibility="gone">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropdownProgram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Week slider -->
                <LinearLayout
                    android:id="@+id/layoutWeekSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_week_slider"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/textSelectedWeek"
                            style="@style/Grow.StatusPill"
                            android:backgroundTint="?attr/colorSecondaryContainer"
                            android:text="@string/week_placeholder"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:stepSize="1.0"
                        android:valueFrom="0.0"
                        android:valueTo="1.0"
                        app:labelBehavior="gone" />
                </LinearLayout>

                <!-- Ratio slider -->
                <LinearLayout
                    android:id="@+id/layoutRatioSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textRatioTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_ratio_slider"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/textSelectedRatio"
                            style="@style/Grow.StatusPill"
                            android:backgroundTint="?attr/colorSecondaryContainer"
                            android:text="@string/ratio_placeholder"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRatio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:stepSize="1.0"
                        android:value="2.0"
                        android:valueFrom="0.0"
                        android:valueTo="4.0"
                        app:labelBehavior="gone" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipManufacturerMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manufacturer_mode_default"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:visibility="gone"
                        app:chipBackgroundColor="?attr/colorTertiaryContainer"
                        app:chipCornerRadius="100dp"
                        app:chipStrokeWidth="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Water & batch -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Grow.Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/label_water_section"
                    android:textAppearance="@style/TextAppearance.Grow.Overline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutVolume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_volume">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789.,"
                            android:inputType="numberDecimal"
                            android:text="10.0" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_baseline_ec">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editBaselineEc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789.,"
                            android:inputType="numberDecimal"
                            android:text="0.0" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_water_analysis_input"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_water_ca">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editWaterCa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789.,"
                            android:inputType="numberDecimal"
                            android:text="0.0" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_water_mg">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editWaterMg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789.,"
                            android:inputType="numberDecimal"
                            android:text="0.0" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Result -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            style="@style/Widget.Grow.Card.Result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="@string/label_total_ec"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/textTotalEc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="EC: --"
                    android:textAppearance="@style/TextAppearance.Grow.BigNumber" />

                <!-- Components -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/label_components"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:id="@+id/layoutComponents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_tile"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp" />

                <!-- Analysis -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/label_analysis_section"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Grow.StatTile"
                        android:layout_marginEnd="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_n_short" />

                        <TextView
                            android:id="@+id/textTotalN"
                            style="@style/Grow.StatValue" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Grow.StatTile"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_p_short" />

                        <TextView
                            android:id="@+id/textTotalP"
                            style="@style/Grow.StatValue" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Grow.StatTile"
                        android:layout_marginStart="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_k_short" />

                        <TextView
                            android:id="@+id/textTotalK"
                            style="@style/Grow.StatValue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Grow.StatTile"
                        android:layout_marginEnd="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_ca_short" />

                        <TextView
                            android:id="@+id/textTotalCa"
                            style="@style/Grow.StatValue" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Grow.StatTile"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_mg_short" />

                        <TextView
                            android:id="@+id/textTotalMg"
                            style="@style/Grow.StatValue" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Grow.StatTile"
                        android:layout_marginStart="4dp">

                        <TextView
                            style="@style/Grow.StatLabel"
                            android:text="@string/label_ratio_short" />

                        <TextView
                            android:id="@+id/textTotalRatio"
                            style="@style/Grow.StatValue" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textRatioAssessment"
                    style="@style/Grow.StatusPill"
                    android:layout_marginTop="12dp" />

                <!-- Water base -->
                <View style="@style/Grow.Divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/label_water_base"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <LinearLayout style="@style/Grow.KeyRow">

                    <TextView
                        style="@style/Grow.KeyLabel"
                        android:text="@string/label_ca_mg_short" />

                    <TextView
                        android:id="@+id/textWaterCaMg"
                        style="@style/Grow.KeyValue" />
                </LinearLayout>

                <LinearLayout style="@style/Grow.KeyRow">

                    <TextView
                        style="@style/Grow.KeyLabel"
                        android:text="@string/label_ca_mg_ratio" />

                    <TextView
                        android:id="@+id/textWaterRatio"
                        style="@style/Grow.KeyValue" />
                </LinearLayout>

                <!-- Water analysis (ratio mode only) -->
                <LinearLayout
                    android:id="@+id/layoutWaterAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View style="@style/Grow.Divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/label_water_analysis"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_water_ca" />
                        <TextView android:id="@+id/textResWaterCa" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_water_mg" />
                        <TextView android:id="@+id/textResWaterMg" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_fertilizer_mg" />
                        <TextView android:id="@+id/textResFertMg" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_epsom_dosage" />
                        <TextView android:id="@+id/textResEpsomMg" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_total_mg_post" />
                        <TextView android:id="@+id/textResTotalMg" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_target_ca" />
                        <TextView android:id="@+id/textResTargetCa" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_extra_ca_needed" />
                        <TextView android:id="@+id/textResExtraCa" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Grow.KeyRow">
                        <TextView style="@style/Grow.KeyLabel" android:text="@string/label_final_ca_dosage" />
                        <TextView android:id="@+id/textResFinalCa" style="@style/Grow.KeyValue" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textWaterNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.8"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="italic" />
                </LinearLayout>

                <!-- Notes -->
                <View style="@style/Grow.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_notes"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/textNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.85"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
