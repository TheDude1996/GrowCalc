<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/meterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="560dp"
        android:background="@drawable/bg_meter"
        android:clickable="true"
        android:focusable="false">

        <!-- Top bar -->
        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_meter_icon_button"
            android:contentDescription="@string/btn_info"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_meter" />

        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/btnInfo"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintStart_toEndOf="@id/btnInfo"
            app:layout_constraintTop_toTopOf="@id/btnInfo">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_meter_dot"
                android:backgroundTint="@color/meter_live" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.12"
                android:text="@string/status_live"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/on_meter_muted" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_meter_icon_button"
            android:contentDescription="@string/menu_settings"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_meter" />

        <!-- Viewfinder with the measured value -->
        <FrameLayout
            android:id="@+id/viewfinder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/textSaturated"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnInfo"
            app:layout_constraintVertical_bias="0.4"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_viewfinder_corner" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/ic_viewfinder_corner" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/ic_viewfinder_corner" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|start"
                android:importantForAccessibility="no"
                android:rotation="270"
                android:src="@drawable/ic_viewfinder_corner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="44dp">

                <LinearLayout
                    android:id="@+id/btnLightSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_meter_pill"
                    android:clickable="true"
                    android:contentDescription="@string/btn_light_source"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/textLightSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/light_source_sun"
                        android:textColor="@color/on_meter_accent"
                        android:textSize="17sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_light_source_switch"
                        app:tint="@color/on_meter_accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textPpfd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/result_placeholder"
                    android:textColor="@color/on_meter"
                    android:textSize="96sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.06"
                    android:text="@string/label_ppfd"
                    android:textColor="@color/on_meter"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/unit_ppfd"
                    android:textColor="@color/on_meter_muted"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/dotsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/textLux"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/on_meter_muted"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/textSaturated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/warn_sensor_saturated"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/textHint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewfinder" />

        <!-- Bottom: hint and main button -->
        <TextView
            android:id="@+id/textHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/measure_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/on_meter_muted"
            app:layout_constraintBottom_toTopOf="@id/btnMain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btnMain"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_meter_main_button"
            android:contentDescription="@string/btn_hold"
            android:padding="26dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/on_meter" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
